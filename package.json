{
  "name": "localrock-web",
  "version": "0.1.0",
  "private": true,
  "description": "Local web interface for Roborock vacuums on a self-hosted local_roborock_server",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "tsc -p tsconfig.web.json --noEmit && vite build",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "sim": "tsx sim/index.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "mqtt": "5.10.3",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "aedes": "0.51.3",
    "concurrently": "9.1.0",
    "playwright-core": "1.49.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "selfsigned": "2.4.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
